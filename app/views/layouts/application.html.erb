<!DOCTYPE html>
<html>
  <head>
    <title>CivicLink Chigasaki</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark civic-navbar">
        <%= link_to statics_path, class: "title-link-img", aria_label: "トップへ" do %>
          <%= image_tag "icon.png", alt: "CivicLink", class: "site-icon" %>
        <% end %>
        <%= link_to statics_path, class: "navbar-brand civic-title me-auto" do %>
          CivicLink<br>
          <span class="subtitle">Chigasaki</span>
        <% end %>
        <button class="navbar-toggler" type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNavDropdown"
         aria-controls="navbarNavDropdown"
          aria-expanded="false"
          aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
       </button>
        <div class="collapse navbar-collapse" id="navbarNavDropdown">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "トップページ", statics_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "トップページ", statics_path, class: "nav-link d-lg-none" %>
            </li>
            <li class="nav-item">
              <%= link_to "検索", groups_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "検索", groups_path, class: "nav-link d-lg-none" %>
            </li>
            <li class="nav-item">
              <%= link_to "相性診断", new_matching_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "相性診断", new_matching_path, class: "nav-link d-lg-none" %>
            </li>   
            <li class="nav-item">
              <%= link_to "イベントマップ", events_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "イベントマップ", events_path, class: "nav-link d-lg-none" %>
            </li>         
            <li class="nav-item">
              <%= link_to "ポイント", new_citizen_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "ポイント", new_citizen_path, class: "nav-link d-lg-none" %>
            </li>
            <li class="nav-item">
              <%= link_to "CMTI", new_cmti_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "CMTI", new_cmti_path, class: "nav-link d-lg-none" %>
            </li>
            <li class="nav-item">
              <%= link_to "個人ログイン", new_citizen_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "個人ログイン", new_citizen_path, class: "nav-link d-lg-none" %>
            </li>      
            <li class="nav-item">
              <%= link_to "団体ログイン", new_user_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "団体ログイン", new_user_path, class: "nav-link d-lg-none" %>
            </li>      
            <li class="nav-item">
              <%= link_to "管理者ログイン", new_owner_path, class: "btn btn-primary rounded-pill d-none d-lg-inline-block" %>
              <%= link_to "管理者ログイン", new_owner_path, class: "nav-link d-lg-none" %>
            </li>   
          </ul>
        </div>
      </nav>
    </header>
    <main>
      <%= yield %>    
    </main>
      <footer class="civic-footer">
  <div class="footer-left">
    <div class="footer-logo">
      <%= image_tag "icon.png", alt: "CivicLink", class: "footer-icon" %>
      <span class="footer-title">CivicLink Chigasaki</span>
    </div>
    <div class="footer-subtitle">
      関心を、参加へ。参加を、繋がりへ。
    </div>
    <div class="footer-copyright">
      ©Inatsugu Seminar 11th
    </div>
  </div>

  <div class="footer-right">
    <ul class="footer-nav">
      <li><%= link_to "トップページ", statics_path %></li>
      <li><%= link_to "検索", groups_path %></li>
      <li><%= link_to "相性診断", new_matching_path %></li>
      <li><%= link_to "イベントマップ", events_path %></li>
      <li><%= link_to "ポイント", new_citizen_path %></li>
      <li><%= link_to "CMTI", new_cmti_path %></li>
      <li><%= link_to "個人ログイン", new_citizen_path %></li>
      <li><%= link_to "団体ログイン", new_user_path %></li>
      <li><%= link_to "管理者ログイン", new_owner_path %></li>
    </ul>
  </div>
</footer>
  </body>
</html>
