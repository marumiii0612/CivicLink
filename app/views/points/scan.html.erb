<head>
    <%= stylesheet_link_tag 'points', media: 'all', 'data-turbolinks-track': 'reload' %>
</head>

<div class="wrap">
    <div class="title">スキャン</div>

<% @points.each do |point| %>
  <div class="scan" id="point-<%= point.id %>">
    <p>保有ポイント<span><%= point.point %></span></p>

    <%= button_to add_point_path(point),
          method: :post,
          remote: true,
          class: "scan-button" do %>
      <%= image_tag "scan.png", alt: "スキャン", class: "scan-image" %>
    <% end %>
  </div>
<% end %>

  <div class="back">
    <%= link_to "戻る", points_path, class: "back-btn" %>
  </div>
</div>
