<head>
  <%= stylesheet_link_tag 'events', media: 'all', 'data-turbolinks-track': 'reload' %>
</head>

<main class="event-form-page" data-page="groups-edit">
  <div class="page-head">
    <h3 class="page-title">市民団体情報編集</h3>
    <p class="page-desc">市民団体情報を編集してください</p>
  </div>

  <section class="card">
    <div class="card__body">
      <%= form_for @group, html: { class: "event-form" } do |f| %>
        <div class="grid-2">

          <div class="field">
            <%= f.label :name, "団体名", class: "label" %>
            <%= f.text_field :name, size: 30, class: "input", required: true %>
          </div>

          <div class="field">
            <%= f.label :catchphrase, "キャッチフレーズ", class: "label" %>
            <%= f.text_field :catchphrase, size: 30, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :purpose, "目的", class: "label" %>
            <%= f.text_area :purpose, size: "30x2", class: "textarea" %>
          </div>

          <div class="field">
            <%= f.label :about, "活動内容", class: "label" %>
            <%= f.text_area :about, size: "30x2", class: "textarea" %>
          </div>

          <div class="field">
            <%= f.label :phone, "電話番号", class: "label" %>
            <%= f.text_field :phone, size: 30, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :mail, "メールアドレス", class: "label" %>
            <%= f.text_field :mail, size: 30, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :g_area, "活動エリア", class: "label" %>
            <%= f.select :g_area,
              [["茅ヶ崎","茅ヶ崎"],["茅ヶ崎南","茅ヶ崎南"],["海岸","海岸"],["南湖","南湖"],
               ["湘南","湘南"],["鶴嶺東","鶴嶺東"],["鶴嶺西","鶴嶺西"],["松林","松林"],
               ["小和田","小和田"],["松浪","松浪"],["浜須賀","浜須賀"],["湘北","湘北"],
               ["小出","小出"],["茅ヶ崎市外","茅ヶ崎市外"]],
              { include_blank: "選択してください" }, class: "select" %>
          </div>

          <div class="field">
            <%= f.label :g_address, "活動場所", class: "label" %>
            <%= f.text_field :g_address, size: 30, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :genre, "ジャンル", class: "label" %>
            <%= f.select :genre,
              [["保健・医療・福祉","保健・医療・福祉"],["社会教育","社会教育"],["まちづくり","まちづくり"],
               ["観光振興","観光振興"],["農山漁村・中山間地域","農山漁村・中山間地域"],
               ["学術・文化・芸術・スポーツ","学術・文化・芸術・スポーツ"],["環境保全","環境保全"],
               ["災害救援","災害救援"],["地域安全","地域安全"],["人権擁護・平和推進","人権擁護・平和推進"],
               ["国際協力","国際協力"],["男女共同参画","男女共同参画"],["子どもの健全育成","子どもの健全育成"],
               ["情報化社会","情報化社会"],["科学技術振興","科学技術振興"],["経済の活性化","経済の活性化"],
               ["職業能力開発","職業能力開発"],["消費者保護","消費者保護"],["活動の連絡・助言・援助","活動の連絡・助言・援助"]],
              { include_blank: "選択してください" }, class: "select" %>
          </div>

          <div class="field">
            <%= f.label :establishment, "設立年", class: "label" %>
            <%= f.number_field :establishment, size: 10, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :menber, "正会員数", class: "label" %>
            <%= f.number_field :menber, size: 10, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :range, "年齢層", class: "label" %>
            <%= f.text_field :range, size: 30, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :fee_year, "年会費", class: "label" %>
            <%= f.number_field :fee_year, size: 10, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :budget_year, "年間予算", class: "label" %>
            <%= f.text_field :budget_year, size: 30, class: "input" %>
          </div>

          <div class="field">
            <%= f.label :url, "URL", class: "label" %>
            <%= f.text_field :url, size: 30, class: "input", placeholder: "https://example.com" %>
          </div>

          <div class="actions">
            <%= f.submit "保存", class: "btn btn--primary btn--lg" %>
          </div>

        </div>
      <% end %>
    </div>
  </section>
</main>
